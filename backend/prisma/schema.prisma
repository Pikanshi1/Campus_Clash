generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(PLAYER)

  level     Int      @default(1)
  xp        Int      @default(0)
  score     Int      @default(0)
  wins      Int      @default(0)
  matches   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}